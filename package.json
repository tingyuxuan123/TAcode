{
  "name": "tacode",
  "productName": "TACode",
  "version": "0.2.9",
  "private": true,
  "description": "TACode — a local AI coding agent workbench",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main/index.mjs",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "predev": "node scripts/ensure-electron.mjs && rm -rf dist-electron && tsup",
    "dev": "concurrently \"vite --host 127.0.0.1 --port 5177 --strictPort\" \"wait-on tcp:5177 && env -u ELECTRON_RUN_AS_NODE cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5177 electron .\"",
    "dev:attach": "env -u ELECTRON_RUN_AS_NODE cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5177 electron . --remote-debugging-port=9222",
    "build:electron": "rm -rf dist-electron && tsup",
    "build:renderer": "vite build",
    "build": "pnpm build:electron && pnpm build:renderer",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "pnpm build && node scripts/test-browser.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "pack": "pnpm build && electron-builder --mac --win",
    "pack:mac": "pnpm build && electron-builder --mac",
    "pack:win": "pnpm build && electron-builder --win",
    "start": "electron ."
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@napi-rs/keyring": "^1.3.0",
    "@react-symbols/icons": "^1.4.1",
    "dompurify": "^3.4.15",
    "fast-glob": "^3.3.3",
    "katex": "^0.18.7",
    "lucide-react": "^1.41.0",
    "pi-web-access": "0.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remend": "^1.3.1",
    "shiki": "^4.4.3",
    "streamdown": "^2.6.0",
    "virtua": "^0.51.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
