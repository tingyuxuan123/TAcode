@@ -326,6 +326,13 @@ export async function runRpcMode(runtimeHost) {
                 return success(id, "follow_up");
             }
             case "abort": {
+                // TACode patch: clear automatic follow-ups BEFORE waiting for idle.
+                // AgentSession can continue queued messages while abort() awaits settlement,
+                // so clearing after the await allows stale delegation reports to restart it.
+                // User-typed steering messages live in a separate queue and are preserved.
+                session.agent.clearFollowUpQueue();
+                session._followUpMessages.length = 0;
+                session._emitQueueUpdate();
                 await session.abort();
                 return success(id, "abort");
             }
